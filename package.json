{
  "name": "deepprior-website",
  "version": "0.1.0",
  "private": true,
  "description": "DeepPrior interactive studio website",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "build:hero": "node scripts/build-triangle-scene.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:brand": "node scripts/check-brand.mjs",
    "validate": "npm run build:covers && npm run check:content && npm run check:brand && npm run lint && npm run typecheck && npm run build:static",
    "build:market-data": "node scripts/build-market-engine-data.mjs",
    "patch:bundle": "python3 scripts/patch-site-bundle.py",
    "build:covers": "node scripts/build-paper-covers.mjs",
    "build:static": "node scripts/build-static-site.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
